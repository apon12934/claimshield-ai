# ==============================================================================
# ClaimShield AI — Environment Configuration Example
# 2026 8th FinTechathon (Topic D: Insurance Assistant)
# ==============================================================================

# Offline Deterministic Mode (Guarantees 100% test & demo pass rate without external API keys)
DEMO_OFFLINE_MODE=true

# Optional External LLM Provider Keys (Used when DEMO_OFFLINE_MODE=false)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Server Ports & Host Settings
HOST=127.0.0.1
PORT=8000
STREAMLIT_PORT=8501

# Database Configuration (SQLite default with trigger immutability)
DATABASE_URL=sqlite:///./claimshield.db

# Cryptographic Token & OTP Signing Secret
SECRET_KEY=claimshield-fintechathon-2026-hmac-secret-key

# Financial Risk Constraints (10% Disposable Income Cap on Riders)
MAX_DISPOSABLE_INCOME_RIDER_RATIO=0.10
